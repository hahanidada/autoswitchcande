// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Compile Extension",
			"type": "npm",
			"script": "compile",
			"problemMatcher": "$tsc"
		},
		{
			"label": "Start Extension Host (Inspector)",
			"type": "process",
			"command": "${execPath}",
			"args": [
				"--new-window",
				"--extensionDevelopmentPath=${workspaceFolder}",
				"--inspect-extensions=9333"
			],
			"dependsOn": "Compile Extension",
			"problemMatcher": []
		},
		{
			"type": "npm",
			"script": "watch",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"presentation": {
				"reveal": "never"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		}
	]
}
